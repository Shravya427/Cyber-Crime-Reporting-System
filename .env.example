# Cyber Crime Reporting and Investigation Management System Configuration
PORT=5000
FLASK_ENV=development
SECRET_KEY=your_jwt_secret_key_here_change_in_production
JWT_EXPIRATION_HOURS=24

# MongoDB Configuration (Local or Atlas)
# Local: mongodb://localhost:27017/
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=cyber_crime_reporting_db

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
